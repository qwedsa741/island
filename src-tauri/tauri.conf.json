{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Island",
  "version": "0.2.0",
  "identifier": "dev.island.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Island",
        "width": 1220,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": true,
        "dragDropEnabled": true
      },
      {
        "label": "island",
        "title": "Island 浮岛",
        "width": 292,
        "height": 92,
        "minWidth": 292,
        "minHeight": 92,
        "maxWidth": 420,
        "maxHeight": 440,
        "x": 24,
        "y": 80,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/IslandData/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Local-first desktop collector",
    "longDescription": "Collect files, links, and text into a searchable local library.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
